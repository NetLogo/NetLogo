[submodule "models"]
	path = models
	url = https://github.com/NetLogo/models.git
[submodule "extensions/vid"]
	path = extensions/vid
	url = https://github.com/NetLogo/vid.git
[submodule "extensions/view2.5d"]
	path = extensions/view2.5d
	url = https://github.com/NetLogo/View2.5D.git
[submodule "extensions/time"]
	path = extensions/time
	url = https://github.com/NetLogo/Time-Extension
[submodule "test/exports"]
	path = test/exports
	url = https://github.com/NetLogo/Model-Exports
[submodule "helio"]
	path = helio
	url = https://github.com/NetLogo/Helio

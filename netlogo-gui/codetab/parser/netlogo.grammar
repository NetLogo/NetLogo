@context tracker from "./keywords.js"

@external specialize { Identifier } keywords from "./keywords.js" {
  Import,
  Export,
  From,
  As,
  Globals,
  Extensions,
  Includes,
  Breed,
  To,
  ToReport,
  End,
  Own,
  Command,
  Reporter,
  Var,
  Constant,
  ModuleIdentifier,
  ExtensionIdentifier
}

@skip { space | Comment }

@detectDelim

@top Program { declaration* procedure* }

declaration {
  Import ModuleSpec (As Identifier)? |
  Import ImportBlock From ModuleSpec |
  Export IdentBlock |
  Extensions ExtensionsBlock |
  (Globals | Own) VarBlock |
  Includes IncludesBlock |
  Breed BreedBlock
}

ImportBlock { OpenBracket (Identifier | Identifier As Identifier)* CloseBracket }
BreedBlock { OpenBracket AlwaysReporter AlwaysReporter CloseBracket }
IdentBlock { OpenBracket Identifier* CloseBracket }
ExtensionsBlock { OpenBracket ExtensionIdentifier* CloseBracket }
VarBlock { OpenBracket AlwaysVar* CloseBracket }
IncludesBlock { OpenBracket IncludeString* CloseBracket }

ModuleSpec { (Identifier ":")* ModuleIdentifier }

procedure { (To AlwaysCommand | ToReport AlwaysReporter) InputBlock? expression* End }

InputBlock { OpenBracket Identifier+ CloseBracket }

expression {
  ParenExpression |
  BracketExpression |
  (Command | Reporter) (Identifier | Number | String | Constant)*
}

ParenExpression { OpenParen expression+ CloseParen }
BracketExpression { OpenBracket expression* CloseBracket }

@tokens {
  space { @whitespace+ }
  Comment [ openedBy=";" ] { ";" ![\n]* }
  identNoDigit { @asciiLetter | "_" | "." | "?" | "=" | "*" | "!" | "<" | ">" | "#" | "+" | "/" | "%" | "$" | "^" | "'" | "&" | "-" }
  Identifier { identNoDigit (identNoDigit | @digit)* }
  AlwaysCommand { Identifier }
  AlwaysReporter { Identifier }
  AlwaysVar { Identifier }
  Number { "-"? @digit+ ("." @digit+)? ("e" ("+" | "-") @digit+)? }
  String { '"' (!["\n] | "\\\"")* ('"' | '\n' | @eof) }
  IncludeString { String }
  OpenParen { "(" }
  CloseParen { ")" }
  OpenBracket { "[" }
  CloseBracket { "]" }
  @precedence { Number, Identifier }
}
